# CDIMS settings. Copy this file to ".env" (note the dot) and fill in your values.
#
# Where to put it (best first):
#   1. In your HOME folder as  .cdims.env   (outside public_html, so it can never be downloaded)
#   2. Inside the cdims-core folder as  .env
# The web server also refuses to serve any file whose name starts with ".env".
# Lines starting with # are comments. Do not put spaces around "=".

# ---- Database (create the database and user in cPanel > MySQL Databases first)
# On cPanel the names carry your account prefix, for example  myacct_cdims  and  myacct_cdimsuser
CDIMS_DB_HOST=localhost
CDIMS_DB_NAME=myacct_cdims
CDIMS_DB_USER=myacct_cdimsuser
CDIMS_DB_PASS=change-this-database-password

# ---- Mode: "production" hides PHP error details from visitors. Use it on a live server.
CDIMS_ENV=production

# ---- One-time web installer. Set a long random secret, run install.php once, then DELETE this line and install.php.
CDIMS_INSTALL_TOKEN=

# ---- Public address of the site (used in the RSS feed and CAP alerts). Include the folder if the app is in one.
# CDIMS_PUBLIC_URL=https://weather.example.zm

# ---- Names shown on public bulletins and PDFs
CDIMS_ORG_NAME=Zambia Meteorology Department
# CDIMS_ALERT_SENDER=alerts@example.zm

# ---- Emergency contacts printed on public alerts: Label|number pairs separated by semicolons. Nothing is shown if empty.
# Use the official numbers published by the relevant agencies.
# CDIMS_EMERGENCY_CONTACTS=Disaster management unit|+260 000 000000;Emergency services|000

# ---- Sessions: sign people out after this many minutes of inactivity, and never keep a session longer than this
CDIMS_SESSION_IDLE_MIN=60
CDIMS_SESSION_MAX_HOURS=12

# ---- Behind a proxy or CDN (Cloudflare, load balancer)? Turn on ONLY if so, otherwise visitors could fake their address.
# CDIMS_TRUST_PROXY=1

# ---- Time zone for dates and times
CDIMS_TIMEZONE=Africa/Lusaka

# ---- Publish daily/weekly bulletins automatically from the cron job (alerts are never published automatically)
# CDIMS_AUTO_PUBLISH_BULLETINS=1

